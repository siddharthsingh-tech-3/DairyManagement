ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dev:devpass@db:5432/milkdairy
DATABASE_URL_SYNC=postgresql+psycopg2://dev:devpass@db:5432/milkdairy

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute

# --- Business defaults ---
DEFAULT_CGST_PERCENT=2.5
DEFAULT_SGST_PERCENT=2.5
SAME_DAY_ORDER_CUTOFF_HOUR=6
NEXT_DAY_ORDER_CUTOFF_HOUR=21
SCHEDULED_ORDER_EDIT_CUTOFF_DAYS=1

# --- AWS (optional, for S3-backed attachments) ---
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
